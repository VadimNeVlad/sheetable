# Shared local configuration for Compose and the host Go process.
# Copy to .env and replace every your-... placeholder.
# From backend/, use ENV_FILE=../.env go run .
# Compose passes its own service addresses and data path to the app container.

DB_PASSWORD=your-db-password

ADMIN_EMAIL=your-admin-email
ADMIN_PASSWORD=your-admin-password

API_SECRET=your-api-secret

# Host-side development settings (paths are relative to backend/).
APP_ENV=development
DEV=true
PORT=8080
SERVER_URL=http://localhost:3000
CONFIG_PATH=../.data/dev
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sheetable
DB_USER=sheetable
PDF2PNG_URL=http://127.0.0.1:5000/createthumbnail
