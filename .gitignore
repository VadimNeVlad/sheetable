# Dependencies
node_modules/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and test output
build/
dist/
coverage/
docs/
coverage.out
*.out
*.test

# Go binaries produced by local builds
/backend/main
/backend/backend
/backend/*.exe

# Python environments and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local configuration and secrets. Commit only documented examples.
.env
.env.*
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample
.envrc
secrets/
.secrets/
*.secret

# Local runtime data and backups
/backend/config/
/.data/
/data/
/backups/
/tmp/
*.db
*.db-*
*.sqlite
*.sqlite3

# Editors and operating systems
.idea/
.DS_Store
Thumbs.db
Desktop.ini
